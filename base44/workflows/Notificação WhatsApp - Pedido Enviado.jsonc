{
  "name": "Notifica\u00e7\u00e3o WhatsApp - Pedido Enviado",
  "description": "Envia mensagem WhatsApp automaticamente quando um pedido tem status alterado para \"enviado\"",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"enviado\") and (.trigger.data.whatsapp_notified != true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notifica_o_whatsapp_pedido_enviado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendOrderShippedNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendOrderShippedNotification"
  }
}