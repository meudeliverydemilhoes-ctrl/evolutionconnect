{
  "name": "Message",
  "type": "object",
  "properties": {
    "contact_phone": {
      "type": "string",
      "description": "Telefone do contato"
    },
    "text": {
      "type": "string",
      "description": "Texto da mensagem"
    },
    "direction": {
      "type": "string",
      "enum": [
        "sent",
        "received"
      ],
      "description": "Enviada ou recebida"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio da mensagem"
    },
    "whatsapp_message_id": {
      "type": "string",
      "description": "ID \u00fanico da mensagem no WhatsApp (key.id) para deduplica\u00e7\u00e3o"
    }
  },
  "required": [
    "contact_phone",
    "text",
    "direction"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}