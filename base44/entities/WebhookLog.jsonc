{
  "name": "WebhookLog",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "description": "Tipo do evento recebido"
    },
    "instance": {
      "type": "string",
      "description": "Nome da inst\u00e2ncia"
    },
    "remoteJid": {
      "type": "string",
      "description": "JID remoto do contato"
    },
    "fromMe": {
      "type": "boolean",
      "description": "Se a mensagem foi enviada por n\u00f3s"
    },
    "messageText": {
      "type": "string",
      "description": "Texto extra\u00eddo da mensagem"
    },
    "rawBody": {
      "type": "string",
      "description": "Body completo da requisi\u00e7\u00e3o em JSON string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de recebimento"
    }
  },
  "required": []
}