{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do contato"
    },
    "phone": {
      "type": "string",
      "description": "N\u00famero de WhatsApp (com DDI, ex: 5511999999999)"
    },
    "email": {
      "type": "string",
      "description": "Email do contato"
    },
    "profile_pic": {
      "type": "string",
      "description": "URL da foto de perfil do WhatsApp"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das etiquetas aplicadas ao contato",
      "default": []
    },
    "last_message": {
      "type": "string",
      "description": "\u00daltima mensagem recebida"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo contato"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "bloqueado"
      ],
      "default": "ativo",
      "description": "Status do contato"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o contato"
    },
    "is_group": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 um grupo do WhatsApp"
    }
  },
  "required": [
    "phone"
  ]
}