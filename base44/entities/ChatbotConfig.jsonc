{
  "name": "ChatbotConfig",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean",
      "default": false
    },
    "prompt": {
      "type": "string",
      "description": "Prompt/personalidade do bot"
    },
    "delay_seconds": {
      "type": "number",
      "default": 3
    },
    "filter": {
      "type": "string",
      "enum": [
        "all",
        "individual",
        "groups",
        "unread"
      ],
      "default": "individual"
    },
    "model": {
      "type": "string",
      "default": "claude-sonnet-4-5"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}